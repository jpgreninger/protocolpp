<?xml version="1.0" encoding="UTF-8"?>
  <protocolpp ver='5.6.2' format="ppp" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation='../schema/protocolpp.xsd'> 
    <general/>
    <stream number='200..300' packets='3..5' datalen='64:390:1500'>
      <protocol prot='ipsec' dir='DECAP' replay='NORMAL:SHIFT:NORMAL:WINDOW:NORMAL:REPLAY:NORMAL:LATE:NORMAL'>
        <security name='ipsecsa' arlen='256' cipher='AES_GCM:AES_CCM:CHACHA20_POLY1305' audit='false'/>
      </protocol>
    </stream>
  </protocolpp>
