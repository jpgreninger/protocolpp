<?xml version="1.0" encoding="UTF-8"?>
<protocolpp ver='5.6.2' format='ppp' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='../schema/protocolpp.xsd'> 
  <general/>
  <stream number='100..200' packets='10..20' datalen='50..1024'>
    <protocol prot='WIFI' replay='NORMAL:SHIFT:NORMAL:WINDOW:NORMAL:REPLAY:NORMAL:LATE:NORMAL'>
      <security arlen='128'/>
    </protocol>
  </stream>
</protocolpp>
