<?xml version="1.0" encoding="UTF-8"?>
<protocolpp ver='5.6.2' format='ppp' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='../schema/protocolpp.xsd'> 
  <general/>
  <stream number='10..20' packets='3..5' datalen='200..4096'>
    <protocol prot='RSA'>
      <security name='rsasa' bitsize='2048:3072:4096' mode='GENKEYPAIR:PKISIGN:PKIVERIFY' enc='PKCS' padtype='PKCS15'/>
    </protocol>
  </stream>
</protocolpp>
