{
    "protocolpp":{
        "@ver":"5.6.2",
        "@format":"ppp",
        "@xmlns:xsi":"http://www.w3.org/2001/XMLSchema-instance",
        "@xsi:noNamespaceSchemaLocation":"../schema/protocolpp.xsd",
        "general":{
            "stream":{
                "@number":"50..75",
                "@packets":"100..200",
                "@datalen":"1..2048",
                "protocol":{
                    "@prot":"MACSEC",
                    "@replay":"NORMAL",
                    "security":{
                        "@name":"macsecsa",
                        "@arlen":32
                    }
                }
            }
        }
    }
}
