<?xml version="1.0" encoding="UTF-8"?>
  <protocolpp ver='5.6.2' format='ppp' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' xsi:noNamespaceSchemaLocation='../schema/protocolpp.xsd'> 
    <general/>
    <stream number='200..300' packets='10..20' datalen='1..2048'>
      <protocol prot='MACSEC' replay='NORMAL:SHIFT:NORMAL:WINDOW:NORMAL:REPLAY:NORMAL:LATE:NORMAL'>
        <security arlen='32'/>
      </protocol>
    </stream>
  </protocolpp>
