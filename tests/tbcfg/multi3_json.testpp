{
    "testpp":{
        "@ver":"5.6.2",
        "@format":"testpp",
        "@xmlns:xsi":"http://www.w3.org/2001/XMLSchema-instance",
        "@xsi:noNamespaceSchemaLocation":"../schema/testpp.xsd",
        "general":{
            "@platform":"WASP",
            "@endian":"BIG",
            "@ptrsize":8,
            "@sgtsize":16,
            "@loglvl":2,
            "@stdout":"true",
            "@debugclr":"MAGENTA",
            "@infoclr":"BRIGHTWHITE",
            "@warnclr":"YELLOW",
            "@errclr":"RED",
            "@fatalclr":"RED",
            "@passclr":"GREEN"
        },
        "flowring":{
            "@name":"flow0",
            "@index":0,
            "@size":50,
            "@addr":0,
            "inring":{
                "@name":"in0",
                "@index":0,
                "@flow":"flow0",
                "@size":50,
                "@addr":0,
                "@input":"tests/ipsec_json.ppp"
            },
            "responder":{
                "@name":"resp0",
                "@index":0,
                "@threads":1,
                "@flow":"flow0",
                "@input":"in0",
                "@output":"out0",
                "@units":"us",
                "@writelatency":"50..200",
                "@readlatency":"200..500",
                "@computelatency":"1000..2500"
            },
            "outring":{
                "@name":"out0",
                "@index":0,
                "@flow":"flow0",
                "@size":50,
                "@addr":0
            }
        },
        "flowring":{
            "@name":"flow1",
            "@index":1,
            "@size":50,
            "@addr":0,
            "inring":{
                "@name":"in1",
                "@index":1,
                "@flow":"flow1",
                "@size":50,
                "@addr":0,
                "@input":"tests/tls_json.ppp"
            },
            "responder":{
                "@name":"resp1",
                "@index":0,
                "@threads":1,
                "@flow":"flow1",
                "@input":"in1",
                "@output":"out1",
                "@units":"us",
                "@writelatency":"50..200",
                "@readlatency":"200..500",
                "@computelatency":"1000..2500"
            },
            "outring":{
                "@name":"out1",
                "@index":1,
                "@flow":"flow1",
                "@size":50,
                "@addr":0
            }
        },
        "flowring":{
            "@name":"flow2",
            "@index":2,
            "@size":50,
            "@addr":0,
            "inring":{
                "@name":"in2",
                "@index":2,
                "@flow":"flow2",
                "@size":50,
                "@addr":0,
                "@input":"tests/wifi_json.ppp"
            },
            "responder":{
                "@name":"resp2",
                "@index":0,
                "@threads":1,
                "@flow":"flow2",
                "@input":"in2",
                "@output":"out2",
                "@units":"us",
                "@writelatency":"50..200",
                "@readlatency":"200..500",
                "@computelatency":"1000..2500"
            },
            "outring":{
                "@name":"out2",
                "@index":2,
                "@flow":"flow2",
                "@size":50,
                "@addr":0
            }
        }
    }
}
